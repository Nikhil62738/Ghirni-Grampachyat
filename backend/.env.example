# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== Database =====
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/gp_ghirni_tax?retryWrites=true&w=majority

# ===== Auth =====
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ===== Email (choose ONE option) =====
# Email address that sends OTP/receipt/reminder mails (required for both options)
GMAIL_EMAIL=

# Option A (EASIEST): Gmail App Password
#   1. Enable 2-Step Verification on the Gmail account
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces optional)
GMAIL_APP_PASSWORD=

# Option B: Gmail API via Google OAuth2 (leave App Password blank to use this)
#   Generate a refresh token at https://developers.google.com/oauthplayground
#   using scope https://mail.google.com/ . GMAIL_EMAIL above must be the same
#   account that authorized these credentials.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# ===== Razorpay =====
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Default Super Admin (used by npm run seed) =====
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@ghirni.gov.in
SEED_ADMIN_PASSWORD=Admin@12345
